# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contentengine
APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- AI (Claude) ------------------------------------------------------------
# anthropic = real generation (requires ANTHROPIC_API_KEY); mock = labelled placeholder output for demos/tests
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Research Agent may use Anthropic server-side web search (results are stored with citations)
RESEARCH_WEB_SEARCH=false

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/media
# S3-compatible (MinIO, R2, AWS). Set STORAGE_DRIVER=s3 to use.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Media tooling ----------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional automatic transcription via whisper.cpp (see docs/BLOCKERS.md)
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# --- Legal (linked from public application forms) ----------------------------
PRIVACY_URL=
IMPRINT_URL=

# --- Instagram (official Instagram Platform API) ----------------------------
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_PUBLISHING_ENABLED=false
